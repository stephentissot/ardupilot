# EpervierFC custom STM32H723ZGT6: direct-SWD bench bring-up only.
# Pin authority: docs/custom_fc_stm32h723.md, final routed pin table.
MCU STM32H7xx STM32H723xx

# Local-only ID; obtain an official allocation before upstream submission.
APJ_BOARD_ID 9998
OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 0

# Keep the proven H723 direct-boot clock and W25Q64 storage configuration.
# OCTOSPI pins otherwise enable the XIP early-init path, skipping clock init.
define HAL_FORCE_CLOCK_INIT
define HAL_STORAGE_SIZE 32768
define STORAGE_THD_WA_SIZE 2048
MAIN_STACK 0x800
PROCESS_STACK 0x2800
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16
define AP_BOOTLOADER_FLASHING_ENABLED 0

# Unused nets must not be driven on a freshly assembled board.
DEFAULTGPIO INPUT FLOATING
USB_STRING_MANUFACTURER "IMPACTOR"
USB_STRING_PRODUCT "EpervierFC"

# Preserve the prototype's SERIAL1..4 numbering; append ESC telemetry.
SERIAL_ORDER OTG1 USART1 UART4 USART2 USART3 UART7
PA11 OTG_HS_DM OTG1
PA12 OTG_HS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SERIAL1: VisionAI MAVLink; SERIAL2: GPS.
PA9  USART1_TX USART1
PA10 USART1_RX USART1
PD1 UART4_TX UART4
PD0 UART4_RX UART4

# SERIAL3: ELRS/CRSF. Keep RX high through startup (ELRS boot protection).
PD5 USART2_TX USART2
PD6 USART2_RX USART2 HIGH PULLUP

# SERIAL4: additional MAVLink / radioHub.
PC10 USART3_TX USART3
PC11 USART3_RX USART3

# SERIAL5: ESC port, disabled by default until signal levels are verified.
# Keep low-rate bench telemetry off DMA to prioritise the IMUs and timers.
PE7 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

PF8  OCTOSPIM_P1_IO0 OCTOSPI1
PF9  OCTOSPIM_P1_IO1 OCTOSPI1
PF7  OCTOSPIM_P1_IO2 OCTOSPI1
PF6  OCTOSPIM_P1_IO3 OCTOSPI1
PF10 OCTOSPIM_P1_CLK OCTOSPI1
PG6  OCTOSPIM_P1_NCS OCTOSPI1
# Assembled W25Q64JVSSIM reports EF7017, not the prototype's EF4017.
# Existing JEDEC driver entry w25q-dtr matches EF70; accesses remain SDR Quad.
OSPIDEV w25q-dtr OCTOSPI1 MODE3 80*MHZ 23 1
DATAFLASH littlefs:jedec_nor
define AP_FLASH_STORAGE_DIAGNOSTICS 1

# Main sensors on bus 0; external GY-63 / OLED / VL53L0X on bus 1.
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2
I2C_ORDER I2C1 I2C2
# Bench-only, one read scan at boot; cached results replayed over MAVLink.
define HAL_I2C_DIAGNOSTIC_BUS 1

PB12 ICM42688_1_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PD8  ICM42688_1_INT1 INPUT
PD9  ICM42688_1_CLKIN INPUT

PE11 ICM42688_2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4
PE15 ICM42688_2_INT1 INPUT
PB10 ICM42688_2_CLKIN INPUT

# Use the existing Invensensev3 backend without driving CLKIN/INT2.
SPIDEV icm42688_1 SPI2 DEVID1 ICM42688_1_CS MODE3 1*MHZ 8*MHZ
SPIDEV icm42688_2 SPI4 DEVID2 ICM42688_2_CS MODE3 1*MHZ 8*MHZ
# 2026-11-16: measured axes with AHRS_ORIENTATION=0, pins 12..14 forward.
# U14 top/SPI2: (x,y,z)->(y,x,-z); U15 bottom/SPI4: (x,y,z)->(-y,x,z).
# Recalibrate accelerometers and verify all gyro signs after flashing.
IMU Invensensev3 SPI:icm42688_1 ROTATION_ROLL_180_YAW_90
IMU Invensensev3 SPI:icm42688_2 ROTATION_YAW_90
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# DPS368 uses the DPS280/DPS310 register-family backend. Probe both straps;
# acceptance of its ID, pressure and temperature remains an on-board test.
BARO DPS310 I2C:0:0x76
BARO DPS310 I2C:0:0x77
# Optional GY-63 (MS5611) on physical I2C2, logical bus 1.
# Either barometer may be absent; at least one must initialise normally.
BARO MS5611 I2C:1:0x77
BARO MS5611 I2C:1:0x76
COMPASS IST8310 I2C:0:0x0E false ROTATION_NONE
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 1

# OUT1..12 follow physical labels, NOT timer-channel order.
PD12 TIM4_CH1 TIM4 PWM(1) GPIO(50)
PD13 TIM4_CH2 TIM4 PWM(2) GPIO(51)
PD14 TIM4_CH3 TIM4 PWM(3) GPIO(52)
PD15 TIM4_CH4 TIM4 PWM(4) GPIO(53)
PB0  TIM3_CH3 TIM3 PWM(5) GPIO(56)
PB1  TIM3_CH4 TIM3 PWM(6) GPIO(57)
PA7  TIM3_CH2 TIM3 PWM(7) GPIO(55)
PA6  TIM3_CH1 TIM3 PWM(8) GPIO(54)
PC6  TIM8_CH1 TIM8 PWM(9) GPIO(58)
PC7  TIM8_CH2 TIM8 PWM(10) GPIO(59)
PC8  TIM8_CH3 TIM8 PWM(11) GPIO(60)
PC9  TIM8_CH4 TIM8 PWM(12) GPIO(61)

# Reserve TIM2 exclusively for the passive buzzer on PA5 (J15).
# ToneAlarm changes the timer period: never share TIM2 with NeoPixel outputs.
PA5 TIM2_CH1 TIM2 GPIO(80) ALARM

# Same NeoPixel pins/output numbering, independent timer for LED waveforms.
PA0 TIM5_CH1 TIM5 PWM(13) GPIO(62)
PA1 TIM5_CH2 TIM5 PWM(14) GPIO(63)
PA2 TIM5_CH3 TIM5 PWM(15) GPIO(64)
define DEFAULT_NTF_LED_TYPES 256

# ADC3 support is a separate validation step. The current H723 MCU table
# lacks ADC3_map: never substitute ADC1 or invent current-sense scaling.
PF3 VBAT_SENSE_RESERVED INPUT
PF4 CURRENT_SENSE_RESERVED INPUT
define HAL_USE_ADC FALSE
define AP_SCRIPTING_ENABLED 0

define AP_OPENDRONEID_ENABLED 1
include ../include/minimize_features.inc
undef HAL_DISPLAY_ENABLED
define HAL_DISPLAY_ENABLED 1
define AP_NOTIFY_TONEALARM_ENABLED 1

define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD 115
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL2_BAUD 115
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_RCIN
define DEFAULT_SERIAL3_BAUD 420
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL4_BAUD 115
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_None