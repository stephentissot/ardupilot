# First-power-on bench defaults, NOT a flight configuration.
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 115
SERIAL2_PROTOCOL 5
SERIAL2_BAUD 115
SERIAL3_PROTOCOL 23
SERIAL3_BAUD 420
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 115
SERIAL5_PROTOCOL -1
FRAME_CLASS 1
FRAME_TYPE 1

# Reserve all physical actuator outputs as GPIO. Keep ESCs disconnected.
# Function 0 is NOT sufficient: Copter can automatically assign its motors.
# Existing saved parameters take precedence: check these after each flash.
SERVO_GPIO_MASK 4095
SERVO1_FUNCTION -1
SERVO2_FUNCTION -1
SERVO3_FUNCTION -1
SERVO4_FUNCTION -1
SERVO5_FUNCTION -1
SERVO6_FUNCTION -1
SERVO7_FUNCTION -1
SERVO8_FUNCTION -1
SERVO9_FUNCTION -1
SERVO10_FUNCTION -1
SERVO11_FUNCTION -1
SERVO12_FUNCTION -1

# One notification NeoPixel per connector. Adjust LED count on the bench.
SERVO13_FUNCTION 120
SERVO14_FUNCTION 120
SERVO15_FUNCTION 120
NTF_LED_TYPES 256
NTF_LED_LEN 1

# No optional external rangefinder or Remote ID transmitter required yet.
RNGFND1_TYPE 0
DID_ENABLE 0
BATT_MONITOR 0

# Keep compass use and normal arming checks: calibration is still required.
COMPASS_USE 1