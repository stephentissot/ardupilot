# hw definition file for processing by chibios_hwdef.py
# for FK723M1_ZGT6
#
# Temporary local-only board port draft for rapid wiring validation.
# APJ_BOARD_ID must be reserved properly before any upstream submission.

MCU STM32H7xx STM32H723xx

# Temporary local-only board ID for bring-up.
APJ_BOARD_ID 9999

# Enable ArduPilot's OpenDroneID subsystem in this board build.
define AP_OPENDRONEID_ENABLED 1
define OPENDRONEID_ENABLE_DEFAULT 1

# Bring-up now uses the board's real 25 MHz HSE with the local H723 type2
# PLL branch kept in this repository.
OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 1024

# For first wiring validation we still flash the application directly by SWD.
FLASH_RESERVE_START_KB 0
define HAL_STORAGE_SIZE 32768
define HAL_FORCE_CLOCK_INIT

# Raise main and process stacks for early bring-up stability.
MAIN_STACK 0x800
PROCESS_STACK 0x2800

# l:59 stack_ovrflw corresponds to APM_STORAGE_PRIORITY; enlarge storage thread stack.
define STORAGE_THD_WA_SIZE 2048

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

DEFAULTGPIO OUTPUT LOW PULLDOWN

USB_STRING_MANUFACTURER "IMPACTOR"
USB_STRING_PRODUCT "FK723M1_ZGT6"

# Disable bootloader embedding until the local bootloader build is in place.
define AP_BOOTLOADER_FLASHING_ENABLED 0

SERIAL_ORDER OTG1 USART1 UART4 USART2 USART3

# USB
PA11 OTG_HS_DM OTG1
PA12 OTG_HS_DP OTG1

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# USART1 - first telemetry / console / MAVLink port
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# UART4 - GPS
PD1 UART4_TX UART4
PD0 UART4_RX UART4

# USART2 - ELRS / CRSF
PD5 USART2_TX USART2
PD6 USART2_RX USART2 HIGH PULLUP

# USART3 - dedicated MAVLink output for VisionESP32 / bench telemetry
PC10 USART3_TX USART3
PC11 USART3_RX USART3

# On direct-SWD app boot, OCTOSPI pin presence triggers HAL_XIP_ENABLED in hwdef generation.
# Force the normal clock init path so external-flash wiring can coexist with internal-flash boot.
PF8  OCTOSPIM_P1_IO0 OCTOSPI1
PF9  OCTOSPIM_P1_IO1 OCTOSPI1
PF7  OCTOSPIM_P1_IO2 OCTOSPI1
PF6  OCTOSPIM_P1_IO3 OCTOSPI1
PF10 OCTOSPIM_P1_CLK OCTOSPI1
PG6  OCTOSPIM_P1_NCS OCTOSPI1

OSPIDEV w25q OCTOSPI1 MODE3 80*MHZ 23 1

# I2C1 - barometer + compass
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2 - auxiliary OLED display + VL53L0X rangefinder
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2

I2C_ORDER I2C1 I2C2

# SPI2 - primary IMU
PB12 ICM20602_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PC4  ICM20602_INT INPUT

# First-pass motor outputs on TIM4 only
PD12 TIM4_CH1 TIM4 PWM(1) GPIO(50)
PD13 TIM4_CH2 TIM4 PWM(2) GPIO(51)
PD14 TIM4_CH3 TIM4 PWM(3) GPIO(52)
PD15 TIM4_CH4 TIM4 PWM(4) GPIO(53)

PB0 TIM3_CH3 TIM3 PWM(5) GPIO(56)
PB1 TIM3_CH4 TIM3 PWM(6) GPIO(57)
PA7 TIM3_CH2 TIM3 PWM(7) GPIO(55)
PA6 TIM3_CH1 TIM3 PWM(8) GPIO(54)

# Buzzer kept simple as a later audible sanity check.
PA0 TIM2_CH1 TIM2 GPIO(80) ALARM

# SPI devices
SPIDEV icm20602 SPI2 DEVID1 ICM20602_CS MODE3 1*MHZ 8*MHZ
DATAFLASH littlefs:jedec_nor

# Sensors
IMU Invensense SPI:icm20602 ROTATION_NONE
BARO MS5611 I2C:0:0x77

define HAL_DEFAULT_INS_FAST_SAMPLE 1
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_USE_ADC FALSE
define AP_SCRIPTING_ENABLED 0

# Keep the first direct-flash bring-up within the 1 MiB H723 footprint.
include ../include/minimize_features.inc

# Re-enable the lightweight AP_Notify OLED backends on the auxiliary I2C2 bus.
undef HAL_DISPLAY_ENABLED
define HAL_DISPLAY_ENABLED 1

# Conservative first-pass defaults for rapid validation.
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD 115
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL2_BAUD 115
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_RCIN
define DEFAULT_SERIAL3_BAUD 420
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL4_BAUD 115

# Do not enable battery-monitor defaults until analog wiring exists.
